{
  "manifest_version": 3,
  "name": "CDAS 查询结果导出",
  "version": "1.1.0",
  "description": "读取 CDAS 查询结果，导出 CSV、JSON 或复制到表格。支持当前页与通过原有分页连续收集。所有数据在本机处理。",
  "minimum_chrome_version": "109",
  "permissions": ["activeTab", "scripting", "downloads", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "导出 CDAS 查询结果",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
